{
  "$schema": "https://unpkg.com/knip@6.39.0/schema-jsonc.json",
  "workspaces": {
    ".": {
      // Standalone evaluation scripts are also invoked directly by contributors.
      "entry": ["skills/spendly/evals/*.mjs"],
      // CI resolves Next.js here, but it belongs to apps/web.
      "ignoreBinaries": ["next"]
    },
    "apps/cli": {
      // The development build has a separate source entry behind generated output.
      "entry": ["development/index.ts"]
    },
    "packages/backend": {
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    }
  }
}
