{
  "$schema": "https://unpkg.com/knip@6.39.0/schema-jsonc.json",
  "workspaces": {
    ".": {
      // Standalone evaluation scripts are also invoked directly by contributors.
      "entry": ["skills/spendly/evals/*.mjs"],
      // The CI parser resolves this workspace-qualified command at the root;
      // Next.js is installed and checked in apps/web, not in this workspace.
      "ignoreBinaries": ["next", "playwright"]
    },
    "apps/cli": {
      // The development build has a separate source entry behind generated output.
      "entry": ["development/index.ts"]
    },
    "packages/e2e": {
      // Live configs intentionally fail closed without secrets. Do not execute
      // them during offline analysis; list their runner-owned entries explicitly.
      "playwright": false,
      "vitest": false,
      "entry": [
        "playwright.config.ts",
        "vitest*.config.ts",
        "web/**/*.spec.ts",
        "cli/**/*.e2e.ts",
        "src/**/*.test.ts",
        "src/cleanup.ts",
        "src/playwright-setup.ts",
        "src/vitest-setup.ts"
      ]
    },
    "packages/backend": {
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    }
  }
}
