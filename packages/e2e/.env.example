# Load explicitly into the invoking shell; the runner never reads normal .env.local.
# Use ONLY a dedicated development Clerk instance and Convex dev deployment.
SPENDLY_E2E_ENABLED=true
E2E_CONVEX_URL=https://your-e2e-deployment.convex.cloud
E2E_CONVEX_DEPLOY_KEY="dev:your-e2e-deployment|your-development-deploy-key"
E2E_CLERK_ISSUER=https://your-e2e-instance.clerk.accounts.dev
E2E_CLERK_PUBLISHABLE_KEY=pk_test_your-e2e-publishable-key
E2E_CLERK_SECRET_KEY=sk_test_your-e2e-secret-key
E2E_CLERK_OAUTH_CLIENT_ID=your-e2e-public-oauth-client-id
# Optional: also install firefox/webkit before enabling the extended matrix.
E2E_EXTENDED_BROWSERS=false
