{
  "name": "spendly",
  "version": "0.1.0",
  "private": true,
  "description": "Spendly command-line interface",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "spendly": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm clean:production && tsc -p tsconfig.json",
    "build:development": "pnpm clean:development && tsc -p tsconfig.development.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "check-types:development": "tsc -p tsconfig.development.json --noEmit",
    "clean:development": "node scripts/clean-output.mjs development-dist",
    "clean:production": "node scripts/clean-output.mjs dist",
    "dev": "pnpm build:development && node --env-file=.env.local development-dist/development/index.js",
    "pack:verify": "node scripts/verify-package.mjs",
    "prepack": "pnpm build",
    "start": "node dist/index.js",
    "test": "vitest run --environment node"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.0",
    "convex": "catalog:",
    "jose": "^6.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@spendly/config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
