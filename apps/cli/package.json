{
  "name": "spendly",
  "version": "0.1.5",
  "description": "Spendly command-line interface",
  "keywords": [
    "expense-tracker",
    "personal-finance",
    "cli",
    "ai-agent"
  ],
  "homepage": "https://spendly.akhileshdalvi.com/docs/cli",
  "bugs": {
    "url": "https://github.com/akhilesh-dalvi/spendly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhilesh-dalvi/spendly.git",
    "directory": "apps/cli"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "spendly": "dist/index.js"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "audit:release": "node scripts/audit-release-dependencies.mjs",
    "build": "node scripts/clean-output.mjs dist && tsc -p tsconfig.json",
    "build:development": "node scripts/clean-output.mjs development-dist && tsc -p tsconfig.development.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "check-types:development": "tsc -p tsconfig.development.json --noEmit",
    "clean:development": "node scripts/clean-output.mjs development-dist",
    "clean:production": "node scripts/clean-output.mjs dist",
    "dev": "pnpm build:development && node --env-file=.env.local development-dist/development/index.js",
    "prepack": "npm run release:check && npm run build",
    "pack:verify": "node scripts/verify-package.mjs",
    "release:check": "node scripts/verify-release-metadata.mjs",
    "shrinkwrap:generate": "node scripts/generate-shrinkwrap.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "@napi-rs/keyring": "1.3.0",
    "commander": "14.0.3",
    "convex": "1.47.0",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  }
}
