NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional overrides; next.config.ts embeds the public Spendly project DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Production is enabled by default. Local/preview reporting requires true.
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# Source-map uploads: build-only credentials, never NEXT_PUBLIC_.
SENTRY_ORG=akhilesh-rl
SENTRY_PROJECT=spendly-web
# Create an organization CI token (org:ci) in Sentry:
# https://sentry.io/settings/akhilesh-rl/auth-tokens/
# Set in hosting secrets or local .env.local; never commit a token.
SENTRY_AUTH_TOKEN=
